# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Interactive Brokers TWS / IB Gateway
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
# Keep true for research-only. Set false when enabling orders.
IB_READONLY=false
# Must be true (and IB_READONLY=false) for place_equity_order / cancel_order.
IB_ALLOW_ORDERS=true
# Soft notional cap per order (USD). 0 disables.
IB_MAX_ORDER_NOTIONAL=50000
# Seconds before IB request waits (qualify, hist, news) raise. Prevents hung tools.
IB_REQUEST_TIMEOUT=10

# Agent loop
AGENT_MAX_ITERATIONS=18
